{
  "name": "apetek",
  "version": "1.3.5",
  "private": true,
  "description": "Offline Markdown editor with portable equation images",
  "author": "ApeTek contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/*.e2e.ts",
    "test:writer": "node --import tsx --test --test-concurrency=1 tests/writer.integration.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "build": "node scripts/build.mjs",
    "start": "electron --ozone-platform=x11 .",
    "package:linux": "node scripts/package.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "hast-util-to-html": "^9.0.5",
    "katex": "0.16.47",
    "mermaid": "11.17.2",
    "prismjs": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "mdast-util-to-hast": "13.2.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "45.2.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "playwright": "1.62.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "productName": "ApeTek"
}
